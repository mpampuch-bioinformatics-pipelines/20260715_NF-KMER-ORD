{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/pipeline/master/assets/schema_input.json",
    "title": "nf-core/pipeline YAML samplesheet",
    "description": "Per-sample inputs and kmer-ord project/cluster/visualise settings.",
    "type": "array",
    "minItems": 1,
    "$defs": {
        "dr_methods": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "enum": [
                "umap",
                "tsne",
                "trimap",
                "pacmap",
                "localmap",
                "pca",
                "sparse_pca",
                "kernel_pca",
                "lle"
                ]
            }
        },
        "screen_specs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "pattern": "^\\S+=\\S+$",
                "errorMessage": "Screen specs must look like 'method=v1,v2,...' or 'all=v1,v2,...' (no spaces)"
            }
        }
    },
    "items": {
        "type": "object",
        "properties": {
            "id": {
                "type": "string",
                "pattern": "^\\S+$",
                "errorMessage": "Sample id must be provided and cannot contain spaces",
                "meta": "id"
            },
            "reads": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.(fa|fasta|fna|fq|fastq)(\\.gz)?$",
                "errorMessage": "Reads file must be provided, cannot contain spaces, and must end in .fa, .fasta, .fna, .fq, .fastq, or gzipped variants"
            },
            "inject_tsv": {
                "type": "string",
                "format": "file-path",
                "exists": true,
                "pattern": "^\\S+\\.(tsv|txt)$",
                "errorMessage": "Optional inject file must be a .tsv/.txt path without spaces whose first column is 'sequence_id'"
            },
            "kmers": {
                "type": "array",
                "description": "K-mer sizes to run independently for this sample.",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                    "type": "integer",
                    "minimum": 1
                },
                "meta": "kmers"
            },
            "tiara": {
                "type": "boolean",
                "default": false,
                "meta": "tiara"
            },
            "rdna": {
                "type": "boolean",
                "default": false,
                "meta": "rdna"
            },
            "rdna_platform": {
                "type": "string",
                "description": "Sequencing platform for rDNA-miner in kmer-ord project (only used when rdna is true).",
                "enum": ["auto", "ont", "pacbio"],
                "default": "auto",
                "meta": "rdna_platform"
            },
            "dr_project": {
                "$ref": "#/$defs/dr_methods",
                "description": "Dimensionality-reduction methods to run in kmer-ord project workflow.",
                "meta": "dr_project"
            },
            "dr_cluster": {
                "$ref": "#/$defs/dr_methods",
                "description": "Dimensionality-reduction methods to run in kmer-ord cluster workflow.",
                "meta": "dr_cluster"
            },
            "scale": {
                "type": "string",
                "description": "Dataset scale preset for DR hyperparameters.",
                "enum": ["auto", "small", "medium", "large", "default"],
                "default": "auto",
                "meta": "scale"
            },
            "norm": {
                "type": "string",
                "description": "K-mer count normalization method.",
                "enum": ["raw", "relative", "log", "clr", "zscore"],
                "default": "clr",
                "meta": "norm"
            },
            "dims": {
                "type": "integer",
                "description": "Low-dimensional (2D/3D) projection size used by kmer-ord project.",
                "minimum": 1,
                "default": 2,
                "meta": "dims"
            },
            "cluster_dims": {
                "type": "integer",
                "description": "High-dimensional embedding size used by kmer-ord cluster.",
                "minimum": 1,
                "default": 15,
                "meta": "cluster_dims"
            },
            "cluster": {
                "type": "array",
                "description": "Clustering methods to run in kmer-ord cluster.",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                    "type": "string",
                    "enum": ["leiden", "hdbscan", "dbscan"]
                },
                "default": ["hdbscan"],
                "meta": "cluster"
            },
            "leiden_sweep": {
                "type": "boolean",
                "default": false,
                "meta": "leiden_sweep"
            },
            "hdbscan_sweep": {
                "type": "boolean",
                "default": false,
                "meta": "hdbscan_sweep"
            },
            "dbscan_sweep": {
                "type": "boolean",
                "default": false,
                "meta": "dbscan_sweep"
            },
            "pca_pre": {
                "type": "boolean",
                "default": false,
                "meta": "pca_pre"
            },
            "pca_pre_method": {
                "type": ["string", "null"],
                "description": "PCA algorithm for pca_pre: 'pca' (exact, more RAM) or 'ipca' (incremental/batched, low RAM).",
                "enum": ["pca", "ipca", null],
                "default": null,
                "meta": "pca_pre_method"
            },
            "pca_pre_batch_size": {
                "type": ["integer", "null"],
                "description": "IncrementalPCA batch size (only used with pca_pre_method 'ipca').",
                "minimum": 1,
                "default": null,
                "meta": "pca_pre_batch_size"
            },
            "keep_pcs": {
                "type": ["integer", "null"],
                "minimum": 1,
                "default": null,
                "meta": "keep_pcs"
            },
            "keep_variance": {
                "type": ["number", "null"],
                "exclusiveMinimum": 0,
                "maximum": 1,
                "default": null,
                "meta": "keep_variance"
            },
            "screen_params": {
                "type": "boolean",
                "default": false,
                "meta": "screen_params"
            },
            "screen_values1": {
                "$ref": "#/$defs/screen_specs",
                "description": "Explicit axis-1 (count-like) screen values per DR method, e.g. 'umap=5,10,15' or 'all=10,20'.",
                "meta": "screen_values1"
            },
            "screen_values2": {
                "$ref": "#/$defs/screen_specs",
                "description": "Explicit axis-2 screen values per DR method, e.g. 'umap=0.1,0.5'.",
                "meta": "screen_values2"
            },
            "screen_range1": {
                "$ref": "#/$defs/screen_specs",
                "description": "Axis-1 range for auto-generated screen grids, e.g. 'umap=5,50' or 'all=5,50'.",
                "meta": "screen_range1"
            },
            "screen_range2": {
                "$ref": "#/$defs/screen_specs",
                "description": "Axis-2 range for auto-generated screen grids, e.g. 'umap=0.1,0.9'.",
                "meta": "screen_range2"
            },
            "screen_grid": {
                "type": "string",
                "description": "Grid size for auto-generated screens: 'N' (1D) or 'NxM' (2D). Applies to every screened DR method.",
                "pattern": "^\\d+(x\\d+)?$",
                "errorMessage": "screen_grid must be 'N' (e.g. '5') or 'NxM' (e.g. '5x4')",
                "meta": "screen_grid"
            },
            "max_categories": {
                "type": "integer",
                "description": "Max number of categories for categorical feature plots in kmer-ord visualise.",
                "minimum": 1,
                "default": 10,
                "meta": "max_categories"
            },
            "embeddings": {
                "type": "boolean",
                "description": "Generate embedding plots in kmer-ord visualise.",
                "default": true,
                "meta": "embeddings"
            },
            "embedding_mode": {
                "type": "string",
                "description": "Embedding plot mode for kmer-ord visualise.",
                "enum": ["density", "categorical", "continuous", "all"],
                "default": "all",
                "meta": "embedding_mode"
            },
            "features": {
                "type": "boolean",
                "description": "Generate feature plots in kmer-ord visualise.",
                "default": true,
                "meta": "features"
            },
            "threads": {
                "type": ["integer", "null"],
                "minimum": 1,
                "default": null,
                "meta": "threads"
            }
        },
        "required": ["id", "reads", "kmers"]
    },
    "uniqueEntries": ["id"]
}
