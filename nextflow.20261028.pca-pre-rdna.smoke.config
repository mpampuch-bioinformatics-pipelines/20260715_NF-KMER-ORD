// Resource cap for the pca_pre + rDNA smoke test.
// KMER_ORD_PROJECT is labelled process_high_memory, which requests 200 GB.
// withName is applied after labels, so these values replace that request.
// Memory and time still grow on a retry if the task is killed for resources.

process {
    withName: 'KMER_ORD_PROJECT' {
        cpus   = 4
        memory = { 32.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withName: 'KMER_ORD_VISUALISE' {
        cpus   = 2
        memory = { 8.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }
}
